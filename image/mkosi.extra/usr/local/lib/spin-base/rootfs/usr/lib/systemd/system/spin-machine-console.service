# A login prompt on the serial console. Shipped, and NOT enabled.
#
# Nothing starts this unless something links it into getty.target.wants, which the debug
# boot does and production does not. That split is the whole point of the file:
#
#   - The unit is static configuration and belongs in the image, next to every other unit.
#   - Enabling it is a decision about one boot, and belongs to whoever made that boot.
#
# Production does not want it. This image's systemd is the first process of a workload
# inside a VM, and the VM's serial port is where the kernel prints and where whoever runs
# the guest reads its logs. An agetty there would compete for the console with the machine's
# own log stream, and on a guest given no serial port at all it would fail and retry until
# systemd gave up.
#
# Why this and not the distribution's serial-getty@.service: it carries
# `BindsTo=dev-%i.device`, a .device unit exists only if udev announced it, and this image
# used to mask systemd-udevd. Enabling serial-getty then got
# `[DEPEND] Dependency failed for serial-getty@ttyS0.service`, and a drop-in clearing
# BindsTo did not lift it either. This unit has no device dependency to fail.
#
# THAT REASON EXPIRED ON 2026-09-10 and left a hole this file is the wrong place to close.
# udev runs now, so serial-getty@ttyS0 works — and systemd-getty-generator instantiates it
# on its own from console=ttyS0, with nothing in optimize-systemd.sh disabling that
# generator. So the split this file is built around no longer exists: production gets a
# login prompt on the console it prints its kernel log to, which is what the paragraph above
# says production must not have, and it gets it without anybody enabling anything.
#
# The exposure is a prompt and not a way in — configure-system.sh runs `passwd --lock` on
# both accounts — so what it costs is the console competing with the log stream, not access.
# Closing it is a decision, not a cleanup: either mask serial-getty@ttyS0 in the image and
# keep this unit for debug boots, or drop this unit and accept the distribution's on the
# console. Whoever decides should also know that whichever unit runs, agetty sleeps one
# second before its prompt (see machine/cmdline.go) and that Type=idle below holds it until
# systemd's job queue drains, measured at 25 ms.
#
# The port is fixed at ttyS0 rather than templated, because that is the only serial port
# this machine has (see the QEMU device set).

[Unit]
Description=Serial console login (debug boots only)
After=systemd-user-sessions.service
Before=getty.target
IgnoreOnIsolate=yes

[Service]
# The leading "-" keeps a port that cannot be opened from being reported as a crash;
# --noclear leaves the boot messages on screen, and --keep-baud takes the line as QEMU set
# it rather than renegotiating it.
# --autologin root, and there is no password to skip: both accounts in this image are
# locked, because a password in a filesystem every VM boots read-only is one credential
# shared by all of them. Anyone who can attach to this port already holds the VM's disk and
# chose its kernel, so a prompt here would guard nothing.
ExecStart=-/usr/sbin/agetty --noreset --noclear --autologin root --keep-baud 115200 ttyS0 $TERM
Type=idle
Restart=always
RestartSec=1
TTYPath=/dev/ttyS0
TTYReset=yes
TTYVHangup=yes
StandardInput=tty
StandardOutput=tty
IgnoreSIGPIPE=no
SendSIGHUP=yes
