#!/usr/bin/env bash
# Runs inside the image tree, after the packages and mkosi.extra are in place: the three
# scripts, then the configuration files. That order is load-bearing and not stylistic — see
# the copy below.
#
# The scripts are unmodified copies of ones that came from a container image build. They
# are the record of what was measured — optimize-systemd.sh names the milliseconds each
# mask saved — and rewriting them into mkosi's idiom would lose that and gain nothing.
set -euo pipefail

# mkosi runs scripts with a PATH of its own choosing, and it does not include
# /usr/local/bin. The scripts install Task, git-lfs and buildctl there and then run each to
# check it — `task: command not found`, exit 127, with the binary sitting where it was just
# installed. In the Dockerfile this was free: the image's PATH already had it.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

lib=/usr/local/lib/spin-base

"$lib/install-dev-tools.sh"
"$lib/configure-system.sh"
# The licence notices, collected here and not in image/build.sh, because the next line
# deletes them: optimize-systemd.sh ends with `rm -rf /usr/share/doc/*`, which is right for
# an image nobody reads documentation in and wrong for one that is redistributed. GPL
# section 1 and every permissive licence in here require the copyright notices and licence
# text to stay with a copy.
#
# The image still ships none of them — build.sh moves this file out and deletes it, so the
# notices travel with the release rather than inside every VM that boots. Written under
# /var/lib because $lib is removed at the end of this script.
{
    echo "Licences of the software in this image."
    echo "One entry per package, from its own /usr/share/doc/<pkg>/copyright."
    echo "Exact versions are in packages.txt beside this file."
    for c in /usr/share/doc/*/copyright; do
        [ -f "$c" ] || continue
        printf '\n\n======== %s ========\n\n' "$(basename "$(dirname "$c")")"
        cat "$c"
    done
} > /var/lib/spin-machine-licenses.txt

"$lib/optimize-systemd.sh"

# The configuration files, copied *after* the scripts and not delivered by ExtraTrees
# directly, because install-dev-tools.sh installs containerd.io and one of these files is
# that package's conffile. Present beforehand, it is a file dpkg does not know about, so
# `apt install` stops at a conffile prompt with no tty and the whole build fails at
# `end of file on stdin at conffile prompt` (measured 2026-09-07). The Dockerfile had this
# ordering for free by copying the configuration in as its last layer.
#
# The symlinks optimize-systemd.sh makes into sockets.target.wants point at two of these
# files and are dangling until this runs, which is exactly how the Dockerfile behaved.
cp -a "$lib/rootfs/." /

# Build inputs, not something a workload should find at runtime.
rm -rf "$lib"
