#!/usr/bin/env bash
# Runs inside the image tree, after the packages and mkosi.extra are in place. This is the
# tail of spinbox's images/sandbox/Dockerfile — the three scripts, then `COPY rootfs/ /` —
# in the same order, which is load-bearing and not stylistic (see the copy below).
#
# The scripts themselves are unmodified copies. They are the record of what was measured —
# optimize-systemd.sh names the milliseconds each mask saved — and rewriting them into
# mkosi's idiom would lose that and gain nothing.
set -euo pipefail

# mkosi runs scripts with a PATH of its own choosing, and it does not include
# /usr/local/bin. The scripts install Task, git-lfs and buildctl there and then run each to
# check it — `task: command not found`, exit 127, with the binary sitting where it was just
# installed. In the Dockerfile this was free: the image's PATH already had it.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

lib=/usr/local/lib/spin-base

"$lib/install-dev-tools.sh"
"$lib/configure-system.sh"
"$lib/optimize-systemd.sh"

# The configuration files, copied *after* the scripts and not delivered by ExtraTrees
# directly, because install-dev-tools.sh installs containerd.io and one of these files is
# that package's conffile. Present beforehand, it is a file dpkg does not know about, so
# `apt install` stops at a conffile prompt with no tty and the whole build fails at
# `end of file on stdin at conffile prompt` (measured 2026-09-07). The Dockerfile had this
# ordering for free by putting `COPY rootfs/ /` last.
#
# The symlinks optimize-systemd.sh makes into sockets.target.wants point at two of these
# files and are dangling until this runs, which is exactly how the Dockerfile behaved.
cp -a "$lib/rootfs/." /

# Build inputs, not something a workload should find at runtime.
rm -rf "$lib"
