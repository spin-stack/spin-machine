#!/usr/bin/env bash
#
# One tarball, one version: QEMU, its firmware, the kernel, the base image and the tools that
# make and read its filesystem.
#
# Not because it is tidy. `machine.Spec.Fingerprint` hashes by content the files that make a
# machine - the ones hack/fingerprint-diff names - so a release in which any of them moved is
# a different machine. Shipping them separately would let them drift apart and leave the
# last one to notice.
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"

OUTPUT_DIR="${OUTPUT_DIR:-_output}"
KERNEL_ARCH="${KERNEL_ARCH:-x86_64}"
VERSION="${VERSION:-$(git describe --tags --always --dirty 2>/dev/null || echo dev)}"
# The versions and the upstream tarballs' SHA-256s this release was compiled from, read from
# versions.yaml - the same values the builds were handed and checked the tarballs against - so
# SOURCES states them without anybody reading a build file. Nothing passes these in, so there
# is no second copy to disagree: QEMU_VERSION, QEMU_SHA256, KERNEL_*, E2FSPROGS_*, QBOOT_*.
pins=$(go tool versions env qemu kernel e2fsprogs qboot)
while IFS='=' read -r key value; do
  declare "${key}=${value}"
done <<< "${pins}"

RELEASE_NAME="spin-machine-${VERSION}-linux-${KERNEL_ARCH}"
RELEASE_DIR="${OUTPUT_DIR}/release/${RELEASE_NAME}"
SHARE="${RELEASE_DIR}/usr/share/spin-stack"

rm -rf "${OUTPUT_DIR}/release"
mkdir -p "${SHARE}/bin" "${SHARE}/qemu" "${SHARE}/kernel" "${SHARE}/image" "${SHARE}/e2fsprogs"

# Every artefact, and every one required. A release missing a piece is worse than no
# release: it installs, and the thing it left out fails somewhere else — a VM that will not
# start for want of an option ROM, a container with nowhere to write for want of qemu-img.
require() {
  local src="$1" dest="$2" what="$3"
  if [ ! -f "${src}" ]; then
    echo "👹 missing ${what}: ${src}" >&2
    echo "   run: task build" >&2
    exit 1
  fi
  install -m "${4:-0644}" "${src}" "${dest}"
  echo "  ok: $(basename "${dest}")"
}

echo "Packing ${RELEASE_NAME}..."

# The licence travels with the artefacts. A tarball of GPL binaries and an Ubuntu userland
# handed over without the terms is the one packaging mistake that is not recoverable by the
# recipient.
echo "Licence:"
require "LICENSE" "${RELEASE_DIR}/LICENSE" "the licence"
require "NOTICE" "${RELEASE_DIR}/NOTICE" "the notice"

echo "QEMU:"
for b in qemu-system-x86_64 qemu-system-x86_64-tcg qemu-img; do
  require "${OUTPUT_DIR}/bin/${b}" "${SHARE}/bin/${b}" "the ${b} binary" 0755
done

echo "e2fsprogs:"
# mkfs.ext4 and the configuration it reads, together: what an ext4 is made with is what the
# binary and mke2fs.conf default to, and a release carrying one without the other pins half
# of it. debugfs, e2fsck and dumpe2fs from the same build: the boot/ probes edit a copy of the
# base image with this debugfs, because an older one refuses a filesystem with features it
# does not know, and a release is what the lab runs them against.
for b in mkfs.ext4 debugfs e2fsck dumpe2fs; do
  require "${OUTPUT_DIR}/bin/${b}" "${SHARE}/bin/${b}" "the ${b} binary" 0755
done
require "${OUTPUT_DIR}/e2fsprogs/mke2fs.conf" "${SHARE}/e2fsprogs/mke2fs.conf" "mke2fs.conf"

echo "Firmware:"
# pvh.bin is how QEMU enters a PVH ELF kernel and there is no other boot path here;
# efi-virtio.rom is the option ROM of the one NIC the build keeps, and a VM given a
# virtio-net-pci without it does not start at all.
# qboot.bin is the BIOS the machine boots with (machine.DefaultBIOS), built beside QEMU with a
# patches of this repository's; the patches and qboot's licence ship beside it, as the kernel's
# patches ship beside the kernel.
for f in bios.bin bios-256k.bin pvh.bin kvmvapic.bin efi-virtio.rom qboot.bin; do
  require "${OUTPUT_DIR}/qemu/${f}" "${SHARE}/qemu/${f}" "firmware ${f}"
done
# Every patch in the directory, not a list of them: mtrr.patch was added to the build and not to
# a list here, and v20261001.01 shipped a qboot.bin without the change it was built with.
for p in qemu/qboot/*.patch; do
  require "$p" "${SHARE}/qemu/qboot-$(basename "$p")" "qboot's patch $(basename "$p")"
done
require qemu/qboot/COPYING "${SHARE}/qemu/qboot-COPYING" "qboot's licence"
# The patches QEMU is built with, for the same reason: a changed GPL source is distributed with
# its changes. Read from the tree, as qboot's are: the binaries were built from this commit.
mkdir -p "${SHARE}/qemu/patches"
for p in qemu/patches/*.patch; do
  require "$p" "${SHARE}/qemu/patches/$(basename "$p")" "QEMU patch $(basename "$p")"
done

echo "Kernel:"
require "${OUTPUT_DIR}/kernel/vmlinux" "${SHARE}/kernel/vmlinux" "the guest kernel" 0644
require "${OUTPUT_DIR}/kernel/kernel-config" "${SHARE}/kernel/kernel-config" "the kernel config"
# The patches the kernel was built with, as the build applied them: a changed GPL source is
# distributed with its changes.
mkdir -p "${SHARE}/kernel/patches"
patches=("${OUTPUT_DIR}"/kernel/patches/*.patch)
[ -f "${patches[0]}" ] || { echo "👹 missing the kernel's patches: ${OUTPUT_DIR}/kernel/patches" >&2; exit 1; }
for p in "${patches[@]}"; do
  require "$p" "${SHARE}/kernel/patches/$(basename "$p")" "kernel patch $(basename "$p")"
done
echo "Base image:"
require "${OUTPUT_DIR}/image/rootfs.qcow2" "${SHARE}/image/rootfs.qcow2" "the base image" 0444
require "${OUTPUT_DIR}/packages.txt" "${SHARE}/packages.txt" "the image's package list"
require "${OUTPUT_DIR}/licenses.txt" "${SHARE}/licenses.txt" "the image's licence texts"

# What this release is, in a form something other than a human can read. The qemu, kernel,
# bios and pvh checksums are the files `machine.Spec.Fingerprint` hashes (with the initrd's,
# which is not in this tarball) to decide whether a checkpoint may be resumed; the image's is
# reported beside them and is not. fingerprint_sha256 is Fingerprint itself, of the machine
# `spin-machine fingerprint` describes with a named CPU, so no runner's own CPU enters it: it
# moves with those files and also with machine/ - its devices, its shape, how it hashes - which
# a consumer builds from this release's commit. A host wondering why its checkpoints stopped
# resuming diffs this against the previous release's.
fingerprint=$(go run ./cmd/spin-machine fingerprint --release "${SHARE}" --cpu Skylake-Server-v4 |
  sed -n 's/^  "fingerprint": "\([0-9a-f]\{64\}\)",$/\1/p')
if [ -z "${fingerprint}" ]; then
  echo "ERROR: spin-machine fingerprint gave no fingerprint for ${SHARE}" >&2
  exit 1
fi
{
  echo "version=${VERSION}"
  # Which tree this came out of. The version alone does not answer it: for a tagged
  # release it is a name that has to be resolved against a repository somebody still
  # has, and for a development build it is a `git describe` string. A manifest that
  # cannot be read without the repository it came from is half a manifest.
  echo "source_commit=$(git rev-parse HEAD 2>/dev/null || echo unknown)"
  echo "qemu_version=${QEMU_VERSION}"
  echo "kernel_version=${KERNEL_VERSION}"
  echo "e2fsprogs_version=${E2FSPROGS_VERSION}"
  echo "built=$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "qemu_sha256=$(sha256sum "${SHARE}/bin/qemu-system-x86_64" | cut -d' ' -f1)"
  echo "kernel_sha256=$(sha256sum "${SHARE}/kernel/vmlinux" | cut -d' ' -f1)"
  echo "bios_sha256=$(sha256sum "${SHARE}/qemu/qboot.bin" | cut -d' ' -f1)"
  echo "pvh_sha256=$(sha256sum "${SHARE}/qemu/pvh.bin" | cut -d' ' -f1)"
  echo "fingerprint_sha256=${fingerprint}"
  echo "image_sha256=$(sha256sum "${SHARE}/image/rootfs.qcow2" | cut -d' ' -f1)"
} > "${SHARE}/machine.env"
echo "Manifest:"
sed 's/^/  /' "${SHARE}/machine.env"

# Where every part of this release came from.
#
# The licence on this repository covers the recipes. What the recipes build is other
# people's software — QEMU and Linux are GPL-2.0, the userland is several thousand files
# under a dozen licences — and shipping their binaries carries obligations that a LICENSE
# file in a source tree does not discharge. This is the part that answers them: what was
# built, from exactly which source, and how to get that source.
#
# Written from the same values the build verified, not from a list maintained by hand:
# the two SHA-256s are checked against the downloaded tarballs during the build, and
# packages.txt is generated from the image tree's own dpkg database.
cat > "${SHARE}/SOURCES" <<SOURCES
spin-machine ${VERSION}
Sources for the third-party software in this release.

This release contains software under the GNU General Public License, the GNU Lesser
General Public License and other licences; see NOTICE for what is under which. The
complete corresponding source for the GPL and LGPL components is available as set out
below. The statically linked libraries in the QEMU and e2fsprogs binaries are covered by the same offer,
which satisfies section 6 of the LGPL by making a relinkable build reproducible from source.

QEMU ${QEMU_VERSION}
  binaries: usr/share/spin-stack/bin/qemu-system-x86_64
            usr/share/spin-stack/bin/qemu-system-x86_64-tcg
            usr/share/spin-stack/bin/qemu-img
  firmware: usr/share/spin-stack/qemu/*, except patches/, qboot.bin and the qboot files below
  source:   https://download.qemu.org/qemu-${QEMU_VERSION}.tar.xz
  sha256:   ${QEMU_SHA256}
  built by: qemu/Dockerfile, with usr/share/spin-stack/qemu/patches applied to that source
            (each says what it changes and why) and the configure flags in that file

qboot ${QBOOT_COMMIT}
  binary:   usr/share/spin-stack/qemu/qboot.bin
  source:   https://github.com/bonzini/qboot, commit ${QBOOT_COMMIT}; the sha256 of what
            \`git archive\` writes for it is ${QBOOT_ARCHIVE_SHA256}
  licence:  GPL-2.0, usr/share/spin-stack/qemu/qboot-COPYING
  built by: qemu/Dockerfile's qboot stage, with usr/share/spin-stack/qemu/qboot-*.patch applied
            to that source in the order that file applies them, and its compiler flags

e2fsprogs ${E2FSPROGS_VERSION}
  binaries: usr/share/spin-stack/bin/mkfs.ext4, debugfs, e2fsck, dumpe2fs
  config:   usr/share/spin-stack/e2fsprogs/mke2fs.conf, upstream's, from the same tarball
  source:   https://mirrors.edge.kernel.org/pub/linux/kernel/people/tytso/e2fsprogs/v${E2FSPROGS_VERSION}/e2fsprogs-${E2FSPROGS_VERSION}.tar.xz
  sha256:   ${E2FSPROGS_SHA256}
  built by: e2fsprogs/Dockerfile, unpatched, statically linked against the Alpine libraries
            named there; their sources are the Alpine package sources for that release

Linux ${KERNEL_VERSION}
  binary:   usr/share/spin-stack/kernel/vmlinux
  source:   https://cdn.kernel.org/pub/linux/kernel/v${KERNEL_VERSION%%.*}.x/linux-${KERNEL_VERSION}.tar.xz
  sha256:   ${KERNEL_SHA256}
  built by: kernel/Dockerfile, with the patches shipped alongside the binary in
            usr/share/spin-stack/kernel/patches applied to that source (each says what
            it changes and why), and the configuration shipped as
            usr/share/spin-stack/kernel/kernel-config

Ubuntu userland
  image:    usr/share/spin-stack/image/rootfs.qcow2
  contents: usr/share/spin-stack/packages.txt — every package and its exact version
  licences: usr/share/spin-stack/licenses.txt — the copyright and licence text of each
  source:   the Ubuntu archive. For any package listed there:
                apt-get source <package>=<version>
  built by: image/mkosi.conf and the scripts beside it

Written offer
  For three years from the date of this release, the copyright holders will provide, to
  anyone who asks, the complete corresponding machine-readable source for the GPL and
  LGPL software in it, on a medium customarily used for software interchange, for no more
  than the cost of performing the distribution. Requests go to the issue tracker of the
  repository this release was built from.
SOURCES
echo "Sources:"
echo "  ok: SOURCES"

TARBALL="${OUTPUT_DIR}/release/${RELEASE_NAME}.tar.gz"
tar -czf "${TARBALL}" -C "${OUTPUT_DIR}/release" "${RELEASE_NAME}"
sha256sum "${TARBALL}" | sed "s|${OUTPUT_DIR}/release/||" > "${TARBALL}.sha256"

# The manifest again, beside the tarball rather than inside it, so that it can be published
# as an asset of its own and read back without the 1 GB around it.
#
# That is what makes the next release able to say whether it breaks this one:
# hack/fingerprint-diff fetches this file for the previous release and compares the
# checksums that decide it. Downloading a whole tarball to read a few lines would be a cost
# nobody pays, which is another way of saying the comparison would not happen.
cp "${SHARE}/machine.env" "${OUTPUT_DIR}/release/machine.env"

echo
echo "✓ ${TARBALL}"
echo "  $(du -h "${TARBALL}" | cut -f1)"
