lab: fast snapshot load in huge pages

spin-stack/spin#1004, a lab branch only. A fast snapshot load places 4 KiB pages,
and the guest then pays a fault a page: 3 s a gigabyte on the bench fleet
(spin-machine lab run 42731318356). SPIN_LAB_LAZY=collapse collapses RAM into
huge pages once the load is complete; =around also loads and collapses the
2 MiB around each fault. Selected by the environment so one build is booted
as every variant.

--- a/migration/postcopy-ram.c	2026-11-09 22:31:51.502740569 -0300
+++ b/migration/postcopy-ram.c	2026-11-09 22:32:54.036810990 -0300
@@ -118,6 +118,123 @@
 #include <linux/userfaultfd.h>
 
 /*
+ * spin lab (spin-stack/spin#1004), not for a release: what a fast snapshot load
+ * leaves the guest to pay. Its pages are placed one 4 KiB page at a time, so a
+ * guest that touches a gigabyte takes 262144 faults where a load that wrote the
+ * memory takes 512 on huge pages. SPIN_LAB_LAZY in the environment:
+ *
+ *   collapse  once the load is complete, every 2 MiB that is mostly the file's
+ *             is collapsed into a huge page, on a thread of its own
+ *   around    that, and a fault loads the 2 MiB around it and collapses it,
+ *             and the eager thread collapses each 2 MiB it completes
+ */
+#ifndef MADV_COLLAPSE
+#define MADV_COLLAPSE 25
+#endif
+#define SPIN_LAB_CHUNK (2 * 1024 * 1024UL)
+
+static GPtrArray *spin_lab_dense;
+static unsigned long spin_lab_early, spin_lab_refused;
+
+static int spin_lab_mode(void)
+{
+    static int mode = -1;
+
+    if (mode < 0) {
+        const char *v = getenv("SPIN_LAB_LAZY");
+        mode = !v ? 0 : !strcmp(v, "collapse") ? 1 : !strcmp(v, "around") ? 2 : 0;
+    }
+    return mode;
+}
+
+/* The 2 MiB of @rb that holds @offset, when the block has whole ones. */
+static bool spin_lab_chunk(RAMBlock *rb, ram_addr_t offset, ram_addr_t *start)
+{
+    uintptr_t host = (uintptr_t)qemu_ram_get_host_addr(rb);
+
+    if (qemu_ram_pagesize(rb) != qemu_real_host_page_size() ||
+        host % SPIN_LAB_CHUNK) {
+        return false;
+    }
+    *start = ROUND_DOWN(offset, SPIN_LAB_CHUNK);
+    return *start + SPIN_LAB_CHUNK <= rb->used_length;
+}
+
+/*
+ * A huge page over 2 MiB the file holds one page of is 2 MiB of host memory
+ * for 4 KiB of the guest's: only where half of it is the file's.
+ */
+static bool spin_lab_is_dense(RAMBlock *rb, ram_addr_t start)
+{
+    return bitmap_count_one_with_offset(rb->file_bmap,
+                                        start >> qemu_target_page_bits(),
+                                        SPIN_LAB_CHUNK >> qemu_target_page_bits())
+           >= 256;
+}
+
+static void spin_lab_collapse(RAMBlock *rb, ram_addr_t start)
+{
+    void *addr = (uint8_t *)qemu_ram_get_host_addr(rb) + start;
+
+    if (madvise(addr, SPIN_LAB_CHUNK, MADV_COLLAPSE) == 0) {
+        qatomic_inc(&spin_lab_early);
+    } else {
+        qatomic_inc(&spin_lab_refused);
+    }
+}
+
+static int spin_lab_note_dense(RAMBlock *rb, void *opaque)
+{
+    ram_addr_t start, first;
+
+    if (!rb->file_bmap || !spin_lab_chunk(rb, 0, &first)) {
+        return 0;
+    }
+    for (start = 0; start + SPIN_LAB_CHUNK <= rb->used_length;
+         start += SPIN_LAB_CHUNK) {
+        if (spin_lab_is_dense(rb, start)) {
+            g_ptr_array_add(spin_lab_dense,
+                            (uint8_t *)qemu_ram_get_host_addr(rb) + start);
+        }
+    }
+    return 0;
+}
+
+static void *spin_lab_collapse_thread(void *opaque)
+{
+    GPtrArray *chunks = opaque;
+    gint64 began = g_get_monotonic_time();
+    unsigned long ok = 0;
+    guint i;
+
+    for (i = 0; i < chunks->len; i++) {
+        if (madvise(g_ptr_array_index(chunks, i), SPIN_LAB_CHUNK,
+                    MADV_COLLAPSE) == 0) {
+            ok++;
+        }
+    }
+    error_report("spin-lab: collapsed %lu of %u chunks in %" PRId64
+                 " ms after the load; during it %lu, refused %lu",
+                 ok, chunks->len, (g_get_monotonic_time() - began) / 1000,
+                 qatomic_read(&spin_lab_early), qatomic_read(&spin_lab_refused));
+    g_ptr_array_free(chunks, true);
+    return NULL;
+}
+
+/* With userfault off the blocks: nothing is refused for a page not yet there. */
+static void spin_lab_collapse_after_load(void)
+{
+    QemuThread thread;
+
+    if (!spin_lab_dense) {
+        return;
+    }
+    qemu_thread_create(&thread, "spin-lab-collapse", spin_lab_collapse_thread,
+                       spin_lab_dense, QEMU_THREAD_DETACHED);
+    spin_lab_dense = NULL;
+}
+
+/*
  * Here we use 24 buckets, which means the last bucket will cover [2^24 us,
  * 2^25 us) ~= [16, 32) seconds.  It should be far enough to record even
  * extreme (perf-wise broken) 1G pages moving over, which can sometimes
@@ -850,6 +967,7 @@
         close(mis->userfault_fd);
         close(mis->userfault_event_fd);
         mis->have_fault_thread = false;
+        spin_lab_collapse_after_load();
     }
 
     if (should_mlock(mlock_state)) {
@@ -1078,6 +1196,32 @@
 }
 
 /*
+ * spin lab: the rest of the 2 MiB a fault was in, after the page the guest
+ * waits for, and a huge page over it.
+ */
+static void spin_lab_load_around(MigrationIncomingState *mis, RAMBlock *rb,
+                                 ram_addr_t rb_offset)
+{
+    uint8_t *host = qemu_ram_get_host_addr(rb);
+    Error *err = NULL;
+    ram_addr_t start, off;
+
+    if (!spin_lab_chunk(rb, rb_offset, &start) || !spin_lab_is_dense(rb, start)) {
+        return;
+    }
+    for (off = start; off < start + SPIN_LAB_CHUNK;
+         off += qemu_target_page_size()) {
+        if (!postcopy_mapped_ram_load_page(mis, rb, off,
+                                           (uint64_t)(uintptr_t)(host + off),
+                                           RAM_CHANNEL_POSTCOPY, &err)) {
+            error_report_err(err);
+            return;
+        }
+    }
+    spin_lab_collapse(rb, start);
+}
+
+/*
  * NOTE: @tid is only used when postcopy-blocktime feature is enabled, and
  * also optional: when zero is provided, the fault accounting will be ignored.
  */
@@ -1580,6 +1724,9 @@
                         break;
                     }
                 }
+                if (spin_lab_mode() == 2) {
+                    spin_lab_load_around(mis, rb, rb_offset);
+                }
             } else {
 retry:
                 /*
@@ -1907,6 +2054,15 @@
             migrate_error_propagate(s, errp);
             return -1;
         }
+        if (spin_lab_mode() == 2) {
+            ram_addr_t start;
+
+            if ((page_loc + qemu_ram_pagesize(rb)) % SPIN_LAB_CHUNK == 0 &&
+                spin_lab_chunk(rb, page_loc, &start) &&
+                spin_lab_is_dense(rb, start)) {
+                spin_lab_collapse(rb, start);
+            }
+        }
     }
     return 0;
 }
@@ -1928,6 +2084,11 @@
         next_state = MIGRATION_STATUS_FAILED;
     } else {
         next_state = MIGRATION_STATUS_COMPLETED;
+        if (spin_lab_mode()) {
+            /* Here, while the blocks still have the file's bitmap. */
+            spin_lab_dense = g_ptr_array_new();
+            foreach_not_ignored_block(spin_lab_note_dense, NULL);
+        }
     }
     migrate_set_state(&mis->state, MIGRATION_STATUS_POSTCOPY_ACTIVE,
                       next_state);
